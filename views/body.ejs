<div class="content">
   <div class="container-fluid">
        <div class="contentwrap">

            <div class="group" style="border: none;background: none;margin: 5px 0 10px;">
                <div style="position: absolute;top: 5px;right: 100px;" id="addGroup">
                    <a href="javascript:;">添加新组</a>
                </div>

                <div style="position: absolute;top: 5px;right: 10px;" id="export">
                    <a href="/export">导出全部</a>
                </div>
            </div>

            <%
                for(var i in groups){
                    var group = groups[i];
            %>
                    <div class="groupWrap">
                        <div class="group">
                            <span class="groupName">
                                <%= group %>
<!--                                <button type="button" class="close">-->
<!--                                    <span aria-hidden="true">×</span>-->
<!--                                </button>-->
                            </span>
                            <span class="glyphicon glyphicon-remove removeGroupBtn" aria-hidden="true"></span>
                        </div>
            <%
                        for(var j in ret){
                            var subGroup = ret[j].group,
                            linkName = ret[j].linkName,
                            url = ret[j].url;
                            /*
                            url = ret[j].url.split(/(ftp|https?):\/\//);
                            url = url[url.length - 1];
                            if(!/^http/.test(url)){
                                url = "//" + url;
                            }*/
                            if(subGroup == group){
                                if(linkName){
                        %>
                                <div class="links">
                                    <a href="<%= url %>" target="_blank">
                                        <span class="linkName"><%= linkName %></span>
                                    </a>
                                    <span class="glyphicon glyphicon-edit" aria-hidden="true" style="display: none;"></span>
                                </div>
                        <%
                                }
                            }
                        }
                        %>
                        <div class="links addNewLinks" index="<%= i %>">
                            <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
                            <a href="javascript:;">
                                <span class="linkName" domdot="addLink">添加新链接</span>
                            </a>
                        </div>
                    </div>
                        <%
                }
            %>
        </div>
	<div style="margin: 0 40px;">
		<span style="color:red;display:block;margin:0 20px;">便宜好用的大牌VPS--Vultr，每月5美元，新人注册送100美元使用抵扣</span>
			<a href="https://www.vultr.com/?ref=8486083-6G"><img id="banner" src=""></a>
	</div> 

    </div>
</div>

<div class="modal fade" id="addNewGroupPopup" role="dialog" aria-labelledby="modal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addGroup-title" domdot="addGroup">添加新组</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control addNewLinksName" placeholder="输入组名">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" domdot="cancelGroup">取消</button>
                <button type="button" class="btn btn-primary saveGroupBtn" domdot="saveGroup">保存</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade" id="removeGroupPopup" role="dialog" aria-labelledby="modal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addGroup-title" domdot="delete">删除该组</h4>
            </div>
            <div class="modal-body">
                <p>删除组后，组内保存链接不可恢复，确认删除吗？</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" domdot="cancel">取消</button>
                <button type="button" class="btn btn-primary" id="deleteGroupBtn" domdot="deleteGroup">确认</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade" id="addNewLinkPopup" role="dialog" aria-labelledby="addLink-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addLink-title">添加新链接</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control addNewLinksName" placeholder="输入网址名">
                <input type="text" class="form-control addNewLinksUrl" placeholder="输入网址">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" domdot="cancelLink">取消</button>
                <button type="button" class="btn btn-primary saveLinkBtn" domdot="saveLink">保存</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->


<div class="modal fade" id="loginPannel" role="dialog" aria-labelledby="login-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true" domdot="cancelLogin">&times;</span></button>
                <h4 class="modal-title" id="login-title">注册登录</h4>
            </div>
            <div class="modal-body">
                <p class="text-center">请使用用户名密码登录，注册请填写用户名和邮箱</p>
                <input type="text" class="form-control userName" placeholder="用户名">
                <input type="password" class="form-control passwd" placeholder="密码">
                <input type="text" class="form-control email" placeholder="邮箱">
            </div>
            <div class="modal-footer" style="margin: 0 auto;text-align: center;">
                <div>
                    <button type="button" class="btn btn-primary" id="signupBtn" disabled domdot="signup">注册</button>
                    <button type="button" class="btn btn-primary" id="loginBtn" disabled domdot="login">登录</button>
                    <a href="javascript:;" id="forgetPasswd" domdot="forget">忘记密码？</a>
                </div>

                <div id="social-login">
                    <span style="color: #78909c">其他方式: </span>
                    <a href="/" id="login-with-github">
                        <i class="iconfont icon-github" aria-hidden="true" style="color: #a1d885;"></i>
                    </a>
<!--                    <a href="/" id="login-with-qq">-->
<!--                        <i class="iconfont icon-qq" aria-hidden="true" style="color: #4cafe9;"></i>-->
<!--                    </a>-->
                    <a href="/" id="login-with-weibo">
                        <i class="iconfont icon-weibo" aria-hidden="true" style="color: #ef8575;"></i>
                    </a>
                </div>
            </div>

        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div id="change">
    <div id="update" domdot="modify">修改</div>
    <div id="remove" domdot="delete">删除</div>
</div>

<div class="modal fade" id="updatePannel" role="dialog" aria-labelledby="update-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="update-title">修改链接</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control link" placeholder="链接名字">
                <input type="text" class="form-control url" placeholder="链接地址">
            </div>
            <div class="modal-footer" style="margin: 0 auto;text-align: center;">
                <button type="button" class="btn btn-default" data-dismiss="modal" domdot="cancelModify">取消</button>
                <button type="button" class="btn btn-primary" id="updateBtn" domdot="saveModify">确定</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade" id="updateGroupPannel" role="dialog" aria-labelledby="updateGroup-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateGroup-title">修改组名</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control newGroup" placeholder="新的组名">
            </div>
            <div class="modal-footer" style="margin: 0 auto;text-align: center;">
                <button type="button" class="btn btn-default" data-dismiss="modal" domdot="saveModifyGroup">取消</button>
                <button type="button" class="btn btn-primary" id="updateGroupBtn" domdot="saveModifyGroup">确定</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade in" id="loginTips" role="dialog" aria-labelledby="loginTips-title">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <!--<div class="modal-header">-->
                <!--<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>-->
                <!--<h4 class="modal-title" id="loginTips-title">修改组名</h4>-->
            <!--</div>-->
            <div class="modal-body">
                <p>是否需要保留默认收藏配置？</p>
                <p>您可以后续修改</p>
            </div>
            <div class="modal-footer" style="margin: 0 auto;text-align: center;">
                <button type="button" class="btn btn-default" id="cancelTipsBtn" data-dismiss="modal" domdot="removeDefault">取消</button>
                <button type="button" class="btn btn-primary" id="loginTipsBtn" domdot="keepDefault">确定</button>
            </div>
        </div><!-- /.modal-content -->
    </div>
</div>

