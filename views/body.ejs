</div>

<div class="content">
    <div class="container-fluid">
        <div class="contentwrap">
            <%
                for(var i in groups){
                    var group = groups[i];
            %>
                    <div class="groupWrap">
                        <div class="group">
                            <span class="groupName"><%= group %></span>
                            <span class="glyphicon glyphicon-plus addGroupBtn" aria-hidden="true"></span>
                        </div>
            <%
                        for(var j in ret){
                            var subGroup = ret[j].group,
                            linkName = ret[j].linkName,
                            url = ret[j].url.split(/(ftp|https?):\/\//);
                            url = url[url.length - 1];
                            if(subGroup == group){
                        %>
                            <div class="links">
                                <a href="//<%= url %>" target="_blank">
                                    <span style="" class="linkName"><%= linkName %></span>
                                </a>
                                <span class="glyphicon glyphicon-edit" aria-hidden="true" style="display: none;"></span>
                            </div>
                        <%
                            }
                        }
                        %>
                        <div class="links addNewLinks" index="<%= i %>">
                            <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>
                            <a href="javascript:;">
                                <span style="" class="linkName">添加新链接</span>
                            </a>
                        </div>
                    </div>
                        <%
                }
            %>
        </div>
    </div>
</div>

<div class="modal fade" id="addNewGroupPopup" role="dialog" aria-labelledby="modal-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addGroup-title">添加新组</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control addNewLinksName" placeholder="输入组名">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary saveGroupBtn">保存</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade" id="addNewLinkPopup" role="dialog" aria-labelledby="addLink-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addLink-title">添加新链接</h4>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control addNewLinksName" placeholder="输入网址名">
                <input type="text" class="form-control addNewLinksUrl" placeholder="输入网址">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary saveLinkBtn">保存</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->


<div class="modal fade" id="loginPannel" role="dialog" aria-labelledby="login-title">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="login-title">注册登录</h4>
            </div>
            <div class="modal-body">
                <p class="text-center">请使用用户名密码登录，未注册需填写邮箱</p>
                <input type="text" class="form-control userName" placeholder="用户名">
                <input type="password" class="form-control passwd" placeholder="密码">
                <input type="text" class="form-control email" placeholder="邮箱">
            </div>
            <div class="modal-footer" style="margin: 0 auto;text-align: center;">
                <button type="button" class="btn btn-primary signupBtn">注册</button>
                <button type="button" class="btn btn-primary loginBtn">登录</button>
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->