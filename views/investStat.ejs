<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>指数定投交易记录工具</title>
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css">
    <style>
        .container-fluid {
            width: 80%;
            text-align: center;
        }
        .des {
            text-align: left;
        }
        th,td {
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <h1>指数定投记录报告</h1>
        <hr>
        <div class="row table-responsive">
            <p class="des">交易记录</p>
            <table class="table table-condensed table-hover table-striped" id="record">
                <thead>
                    <tr>
                        <th>日期</th>
                        <th>标的名</th>
                        <th>标的代码</th>
                        <th>市盈率</th>
                        <th>交易价</th>
                        <th>交易量</th>
                        <th>交易金额</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <hr>
            <p class="des">总计</p>
            <table class="table table-condensed table-hover table-striped" id="sumStatics">
                <thead>
                    <tr>
                        <th>标的名</th>
                        <th>标的代码</th>
                        <th>当前持仓</th>
                        <th>当前金额</th>
                        <th>投入成本</th>
                        <th>利润率</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <script src="/jquery/dist/jquery.min.js"></script>
    <script src="/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="/js/investStat.js"></script>
</body>
</html>